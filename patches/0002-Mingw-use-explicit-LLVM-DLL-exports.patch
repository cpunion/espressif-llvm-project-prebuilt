diff --git a/llvm/tools/llvm-shlib/CMakeLists.txt b/llvm/tools/llvm-shlib/CMakeLists.txt
--- a/llvm/tools/llvm-shlib/CMakeLists.txt
+++ b/llvm/tools/llvm-shlib/CMakeLists.txt
@@ -41,7 +41,7 @@
     llvm_install_library_symlink(LLVM-${LLVM_VERSION_MAJOR}${LLVM_VERSION_SUFFIX} $<TARGET_FILE_NAME:LLVM> SHARED FULL_DEST COMPONENT LLVM)
   endif()
 
-  if (MINGW OR CYGWIN)
+  if ((MINGW OR CYGWIN) AND NOT LLVM_BUILD_LLVM_DYLIB_VIS)
     # The LLVM DLL is supposed to export all symbols (except for ones
     # that are explicitly hidden). Normally, this is what happens anyway, but
     # if there are symbols that are marked explicitly as dllexport, we'd only
diff --git a/llvm/include/llvm/Support/Compiler.h b/llvm/include/llvm/Support/Compiler.h
--- a/llvm/include/llvm/Support/Compiler.h
+++ b/llvm/include/llvm/Support/Compiler.h
@@ -183,11 +183,18 @@
 // TODO(https://github.com/llvm/llvm-project/issues/145406): eliminate need for
 // two preprocessor definitions to gate LLVM_ABI macro definitions.
 #if defined(LLVM_ENABLE_LLVM_EXPORT_ANNOTATIONS) && !defined(LLVM_BUILD_STATIC)
-#if defined(_WIN32) && !defined(__MINGW32__)
+#if defined(_WIN32)
 #if defined(LLVM_EXPORTS)
 #define LLVM_ABI __declspec(dllexport)
+#if defined(__MINGW32__)
+// MinGW requires the export on the extern template declaration; applying
+// it only to the later explicit instantiation definition is ignored.
+#define LLVM_TEMPLATE_ABI __declspec(dllexport)
+#define LLVM_EXPORT_TEMPLATE
+#else
 #define LLVM_TEMPLATE_ABI
 #define LLVM_EXPORT_TEMPLATE __declspec(dllexport)
+#endif
 #else
 #define LLVM_ABI __declspec(dllimport)
 #define LLVM_TEMPLATE_ABI __declspec(dllimport)
diff --git a/llvm/include/llvm-c/Visibility.h b/llvm/include/llvm-c/Visibility.h
--- a/llvm/include/llvm-c/Visibility.h
+++ b/llvm/include/llvm-c/Visibility.h
@@ -26,7 +26,7 @@
 // two preprocessor definitions to gate LLVM_ABI macro definitions.
 #if defined(LLVM_ENABLE_LLVM_C_EXPORT_ANNOTATIONS) &&                          \
     !defined(LLVM_BUILD_STATIC)
-#if defined(_WIN32) && !defined(__MINGW32__)
+#if defined(_WIN32)
 #if defined(LLVM_EXPORTS)
 #define LLVM_C_ABI __declspec(dllexport)
 #else
